# ──────────────────────────────────────────────────────────
# Centralized Environment Configuration (Root .env)
# Medhashree - Quiz & Learning Platform
# ──────────────────────────────────────────────────────────

# Environment & Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=medhashree
DB_SSL=false
# Optional full connection URL (overrides DB_HOST/USER/NAME if set):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/medhashree

# Security
JWT_SECRET=super_secret_jwt_key_medhashree_change_in_production_2026

# Email SMTP Setup (for Password Resets & Admin Alert Emails)
# Example using Gmail App Password:
EMAIL_USER=
EMAIL_PASS=
# Owner / Admin alert receiver email:
ADMIN_EMAIL=admin@medhashree.com

# Online User Threshold Alert Settings
ENABLE_ONLINE_ALERTS=true
ONLINE_USER_ALERT_THRESHOLD=100
ALERT_COOLDOWN_MINUTES=60

# Real-Time Server & Resource Monitoring Settings
ENABLE_RESOURCE_MONITORING=true
RESOURCE_MONITOR_INTERVAL_SEC=10
CPU_WARN_THRESHOLD=85
MEMORY_WARN_THRESHOLD=90

# Frontend Public Parameters (Vite client build)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=
