# Environment mode ('development' or 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Unified Database Connection String (Preferred in production e.g. Supabase, Render, Neon)
# If DATABASE_URL is provided, DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, and DB_NAME are ignored.
# Example: postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_URL=

# Standalone Database Configuration (Fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=medhashree

# Database SSL Configuration
# Set to 'true' to force SSL (required by Supabase/Neon). 
# Set to 'false' to force disable. 
# Defaults to true in production and false in development.
DB_SSL=

# Security
JWT_SECRET=supersecrettoken12345_change_in_production

# CORS / Socket Origins
# Comma-separated list of allowed frontend URLs (e.g. http://localhost:5173,https://yourdomain.com)
# Defaults to '*' if empty (permissive mode)
FRONTEND_URL=

# Email
EMAIL_USER=your_email
EMAIL_PASS=your_email_app_password_without_whitespaces
